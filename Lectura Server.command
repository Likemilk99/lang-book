#!/bin/zsh
# Двойной клик — сервер «Мои фразы» в окне Терминала (Ctrl+C или закрыть окно — остановить).
# Можно сделать ярлык: Finder → правый клик → «Создать псевдоним» и перенести на рабочий стол или в Dock.
cd "$(dirname "$0")" || exit 1
printf '\e]0;Lectura — сервер «Мои фразы»\a'
# caffeinate: пока сервер работает, Mac не уснёт сам (крышку закрывать всё равно нельзя, если он не на зарядке).
caffeinate -i python3 pipeline/server.py "$@"
echo
read -k 1 "?Нажмите любую клавишу, чтобы закрыть окно…"
